# MediBook backend environment configuration
# Copy to `.env` and fill in real values (`.env` is gitignored; this file is committed).

# --- Django ---
DJANGO_SECRET_KEY=
DEBUG=True

# --- Frontend URL (used in email links) ---
FRONTEND_URL=http://localhost:5173

# --- SMTP / Email (leave EMAIL_HOST_USER empty to use the console backend in dev) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@medibook.com
